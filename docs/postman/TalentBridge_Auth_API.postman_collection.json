{
  "info": {
    "name": "TalentBridge - Authentication API (HRPM-24)",
    "description": "Bộ Postman Collection chuẩn kiểm thử API Xác thực, Phân quyền và Token Design",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Đăng ký tài khoản Candidate",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"candidate1@talentbridge.vn\",\n  \"password\": \"Password@123\",\n  \"fullName\": \"Đặng Trường Thịnh\",\n  \"phone\": \"0912345678\",\n  \"role\": \"ROLE_CANDIDATE\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "register"]
        }
      }
    },
    {
      "name": "2. Đăng ký tài khoản Recruiter",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"hr1@fpt.com\",\n  \"password\": \"Password@123\",\n  \"fullName\": \"Nguyễn Phan Minh Hiếu\",\n  \"phone\": \"0987654321\",\n  \"role\": \"ROLE_RECRUITER\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "register"]
        }
      }
    },
    {
      "name": "3. Đăng nhập (Lưu Token tự động)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    pm.collectionVariables.set('accessToken', jsonData.data.accessToken);",
              "    pm.collectionVariables.set('refreshToken', jsonData.data.refreshToken);",
              "    pm.test('Đăng nhập thành công và nhận Token', function () {",
              "        pm.expect(jsonData.statusCode).to.eql(200);",
              "        pm.expect(jsonData.data.accessToken).to.not.be.empty;",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"candidate1@talentbridge.vn\",\n  \"password\": \"Password@123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        }
      }
    },
    {
      "name": "4. Lấy thông tin tài khoản hiện tại (/me)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/me",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "me"]
        }
      }
    },
    {
      "name": "5. Làm mới Access Token (/refresh-token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    pm.collectionVariables.set('accessToken', jsonData.data.accessToken);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/refresh-token",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "refresh-token"]
        }
      }
    }
  ]
}
